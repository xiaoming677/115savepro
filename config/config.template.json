    "file_operations": {
        "rename_delay_seconds": 0.3,
        "batch_size": 50,
        "concurrent_limit": 1
    },
    "offline": {
        "auto_trigger_qms": true,
        "watch_schedule": "*/5 * * * *"
    },
    "update": {
        "allow_self_update": true,
        "auto_check": true

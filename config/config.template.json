        "session_timeout": 3600
    },
    "p115": {
        "users": {},
        "current_user": null,
        "tasks": []
    },
    "cron": {
        "default_schedule": [
            "0 10 * * *"
        ],
        "auto_install": true
    },
    "notify": {
        "enabled": false,
        "notification_delay": 30,
